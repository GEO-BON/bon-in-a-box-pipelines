      "example": [
        "-99",
        "22",
        "-92",
        "29"
      ],
      "weight": 1
    },
    "pipeline@14": {
      "label": "Année de début",
      "description": "Integer, 4 chiffres année, date de début pour récupérer occurrences",
      "type": "int",
      "example": 1980,
      "weight": 2
    },
    "pipeline@15": {
      "label": "Année de fin",
      "description": "Entier, 4 chiffres année, date de fin pour récupérer occurrences",
      "type": "int",
      "example": 2000,
      "weight": 3
    },
    "GFS_IndicatorsTool>get_pop_poly.yml@5|buffer_size": {
      "description": "Taille du rayon [en km] pour déterminer la présence de la population autour des coordonnées des observations des espèces.",
      "label": "Taille de tampon",
      "type": "float",
      "example": 10,
      "weight": 4
    },
    "GFS_IndicatorsTool>get_pop_poly.yml@5|pop_distance": {
      "description": "Distance [en km] pour séparer les observations d'espèces dans différentes populations.",
      "label": "Distance entre les populations",
      "type": "float",
      "example": 50,
      "weight": 5
    }
  },
