    }
  },
  "metadata": {
    "name": "Obtenez des polygones de population de emprise",
    "description": "Composante de l'outil Genes from Space. Compte tenu d'un emprise géographique, d'une espèce d'intérêt et d'une fenêtre temporelle, l'outil rétroduit le occurrences de l'espèce de GBIF, puis calcule les polygones de population en fonction de la proximité géographique. ",
    "lifecycle": {
      "status": "subpipeline"
    },
    "author": [
      {
        "name": "Oliver Selmoni",
        "email": "oliver.selmoni@gmail.com"
      }
    ],
    "license": "MIT",
    "external_link": "https://teams.issibern.ch/genesfromspace/",
    "references": [
      {
        "text": "Schuman et al., EcoEvoRxiv.",
        "doi": "https://doi.org/10.32942/X2RS58"
      }
    ]
  }
