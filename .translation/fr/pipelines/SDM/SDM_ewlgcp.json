  "inputs": {
    "pipeline@121": {
      "label": "Liste taxons",
      "description": "Tableau des valeurs taxons",
      "type": "text[]",
      "example": [
        "Acer saccharum"
      ],
      "weight": 0
    },
    "pipeline@149": {
      "label": "Boundation et SCR",
      "description": "Sélectionnez un emprise et SCR",
      "type": "bboxCRS",
      "example": null,
      "weight": 1
    },
    "SDM>selectBackground.yml@40|method_background": {
      "description": "Méthode utilisée pour échantillonner points d'arrière-plan",
      "label": "Historique de la méthode",
      "type": "options",
      "options": [
        "random",
        "inclusion_buffer",
        "weighted_raster",
        "unweighted_raster"
      ],
      "example": "weighted_raster",
      "weight": 2
    },
    "SDM>selectBackground.yml@40|n_background": {
      "description": "Nombre de points d'arrière-plan",
      "label": "Nombre de points d'arrière-plan",
      "type": "int",
      "example": 100000,
      "weight": 3
    },
    "data>loadFromStac.yml@140|stac_url": {
      "description": "URL du catalogue STAC pour tirer le prédicteur couches.",
      "label": "URL STAC",
      "type": "text",
      "example": "https://stac.geobon.org/",
      "weight": 4
    },
    "data>loadFromStac.yml@140|collections_items": {
      "description": "Nom de la collection de STAC couches suivi de '|' suivi d'un item id",
      "label": "items de collection STAC",
      "type": "text[]",
      "example": [
        "chelsa-clim|bio5",
        "earthenv_landcover|class_1",
        "earthenv_landcover|class_7",
        "earthenv_landcover|class_3"
      ],
      "weight": 5
    },
    "data>loadFromStac.yml@140|study_area": {
      "description": "Polygone de zone d'étude utilisé pour la culture couches de sortie",
      "label": "Zone d'étude",
      "type": "application/geopackage+sqlite3",
      "example": null,
      "weight": 6
    },
    "pipeline@46": {
      "label": "Nombre de blocs",
      "description": "Nombre de blocs (pour la méthode de validation croisée, actuellement ignoré)",
      "type": "int",
      "example": 2,
      "weight": 7
    },
    "pipeline@128": {
      "label": "Résolution spatiale",
      "description": "Entier, résolution spatiale du rasters dans les mêmes unités que le système de coordonnées de référence (mètres pour les systèmes de référence projetés et degrés pour les systèmes de référence en lat long). \n\nSi c'est laissé vide il utilisera la résolution native du rasters. \n\nSi la résolution spatiale est plus grossière que la résolution native du rasters, le couches sera rééchantillonné avec la méthode de rééchantillonnage choisie ci-dessous.",
      "type": "float",
      "example": 1000,
      "weight": 8
