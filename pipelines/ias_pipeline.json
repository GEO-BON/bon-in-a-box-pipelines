  "outputs": {
    "IAS>merge_datasets.yml@52|merged_dataset": {
      "description": "One record per standardised taxon-location-establishment combination.",
      "label": "SInAS merged dataset",
      "type": "text/csv",
      "weight": 0
    },
    "IAS>merge_datasets.yml@52|data_quality_report": {
      "description": "Combined quality-control status, unmatched values, and merge conflicts, including the action taken for each issue.",
      "label": "SInAS data-quality report",
      "type": "text/csv",
      "weight": 1
    },
    "IAS>prepare_datasets.yml@80|excluded_records": {
      "description": "Complete source records excluded from the merge because their locations could not be standardised.",
      "label": "SInAS excluded records",
      "type": "text/csv",
      "weight": 2
    },
    "IAS>merge_datasets.yml@52|run_summary": {
      "description": "Preparation and merge record counts, warning counts, exclusions, and overall quality-control status.",
      "label": "SInAS run summary",
      "type": "text/csv",
      "weight": 3
    },
    "IAS>model_data.yml@81|model_outputs": {
      "description": "Model assumptions, parameters, fit statistics, convergence status, estimated trend direction, interpretation, and caveats for every model option. First-record trends are not automatically equivalent to introduction trends.",
      "label": "Model outputs",
      "type": "text/csv",
      "weight": 4
    },
    "IAS>model_data.yml@81|model_decision": {
      "description": "Selected data scenario, adequacy criteria, supported level of inference, interpretation guidance, shared scope, and references.",
      "label": "Modelling decision",
      "type": "text/csv",
      "weight": 5
    },
    "IAS>model_data.yml@81|data_summary": {
      "description": "Data-adequacy statistics for the selected country. First-record completeness is the percentage of GRIIS taxa flagged invasive anywhere that have a first-record year; it is not overall checklist completeness.",
      "label": "Modelling data summary",
      "type": "text/csv",
      "weight": 6
    },
    "IAS>model_data.yml@81|quantitative_plot": {
      "description": "Fitted annual discovery records from models with alternative detection assumptions. Compare fit statistics only among converged models fitted to the same country and time series.",
      "label": "Quantitative model comparison",
      "type": "image/png",
      "weight": 7
    },
    "IAS>model_data.yml@81|qualitative_plot": {
      "description": "Descriptive comparison of annual IAS first records with the GBIF observation proxy. Similar patterns may indicate an observation-effort effect; this plot is not a corrected introduction-rate estimate.",
      "label": "Qualitative model plot",
      "type": "image/png",
      "weight": 8
    }
  },
