        "text": "Genes from Space Project website",
        "link": "https://genesfromspace.org/"
      },
      {
        "text": "Genes from Space Interface",
        "link": "https://gfstool.com/"
      },
      {
        "text": "ESA Climate Change Initiative",
        "link": "https://climate.esa.int/en/projects/land-cover/"
      }
    ],
    "compute": {
      "hpc": false,
      "mem": "4Gi",
      "cpus-per-task": 4,
      "time": "02:00:00"
    }
  }
