  "inputs": {
    "pipeline@217": {
      "label": "Years of interest",
      "description": "List of years for which landcover should be extracted (maximum range 1992 - 2020).",
      "type": "int[]",
      "example": [
        1995,
        2000,
        2005,
        2010,
        2015,
        2020
      ],
      "weight": 0
    },
    "pipeline@218": {
      "label": "Landcover classes",
      "description": "List of landcover class identifiers to be extract (for identifiers see https://savs.eumetsat.int/html/images/landcover_legend.png)",
      "type": "int[]",
      "example": [
        130,
        140
      ],
      "weight": 1
    },
    "pipeline@214": {
      "label": "Size of buffer",
      "description": "Radius size [in km] to determine population presence around the coordinates of species observations.",
      "type": "float",
      "example": 10,
      "weight": 2
    },
    "pipeline@215": {
      "label": "Distance between populations",
      "description": "Distance [in km] to separate species observations in different populations.",
      "type": "float",
      "example": 50,
      "weight": 3
    },
    "pipeline@211": {
      "label": "Countries list",
      "description": "countries of interest, will be used to look for GBIF observations.",
      "type": "text[]",
      "example": [
        "Colombia"
      ],
      "weight": 4
    },
    "pipeline@224": {
      "label": "Ne:Nc ratio estimate",
      "description": "Estimated Ne:Nc ratio for the studied species. Multiple values can be provided, separated by a comma.",
      "type": "float[]",
      "example": [
        0.1,
        0.2
      ],
      "weight": 5
    },
    "pipeline@225": {
      "label": "Population density",
      "description": "Estimated density of the population [number of individuals per km2]. Multiple values can be provided, separated by a comma.",
      "type": "float[]",
      "example": [
        50,
        100,
        1000
      ],
      "weight": 6
    },
    "pipeline@226": {
      "label": "Title of the run",
      "description": "Set a name for the pipeline run.",
      "type": "text",
      "example": "Quercus sartorii, Mexico, Habitat decline by tree cover loss, 2000-2023",
      "weight": 7
    },
    "GenesFromSpace>ToolComponents>Interface>get_polygon.json@206|pipeline@201": {
      "description": "Path to the table storing the species observation coordinates. The table must incude header with \"decimal_longitude\" and \"decimal_latitude\" columns, indicating the coordinates of every observation.",
      "label": "Coordinates of species occurrence",
      "type": "text/tab-separated-values",
      "example": "/userdata/obs_data.tsv",
      "weight": 8
    }
  },
  "outputs": {
    "GenesFromSpace>ToolComponents>Interface>LC_area.json@216|GFS_IndicatorsTool>pop_area_by_habitat.yml@200|pop_area": {
      "description": "Table of estimated habitat area by population (rows). If available, time points are displayed as columns.",
      "label": "Table of habitat area by population",
      "type": "text/tab-separated-values",
      "weight": 0
    },
    "GenesFromSpace>ToolComponents>Interface>LC_area.json@216|GFS_IndicatorsTool>get_LCY.yml@195|lcyy": {
      "description": "Path to folder with tif files showing the year-by-year disrtribution of land cover classes of interest across populations.",
      "label": "Land cover year-by-year",
      "type": "text",
      "weight": 1
    },
    "GenesFromSpace>ToolComponents>Interface>LC_area.json@216|GFS_IndicatorsTool>get_LCY.yml@195|lc_classes": {
      "description": "ID of LC classes used to evaluate habitat change",
      "label": "Land cover classes ID",
      "type": "text",
      "weight": 2
    },
    "GenesFromSpace>ToolComponents>Interface>LC_area.json@216|GFS_IndicatorsTool>get_LCY.yml@195|output_maps": {
      "description": "resampled maps of cover, cover gain and cover loss map used to visualize cover dynamics in final plot",
      "label": "Cover, cover gain and cover loss map",
      "type": "text",
      "weight": 3
    },
    "GFS_IndicatorsTool>get_Indicators.yml@223|ne_table": {
      "description": "Estimated effective size of every population, based on the latest time point of the habitat cover map.",
      "label": "Effective population size",
      "type": "text/tab-separated-values",
      "weight": 4
    },
    "GFS_IndicatorsTool>get_Indicators.yml@223|pm": {
      "description": "Estimated proportion of mantained populations, comparing earliest and latest time point. A value of 1 means that no populations went extinct over the time frame.",
      "label": "Population maintained indicator",
      "type": "float",
      "weight": 5
    },
    "GFS_IndicatorsTool>get_Indicators.yml@223|interactive_plot": {
      "description": "An interactive interface to explore indicators trends across geographical space and time.",
      "label": "Interactive plot",
      "type": "text/html",
      "weight": 6
    },
    "GFS_IndicatorsTool>get_Indicators.yml@223|ne500": {
      "description": "Estimated proportion of populations with Ne>500 at latest time point.",
      "label": "Ne>500 indicator",
      "type": "float",
      "weight": 7
    }
  },
  "metadata": {
    "name": "Land cover loss by population from CSV File",
    "description": "This Pipeline takes Input parameters such as Species, years of interest and Land cover classes to calculate Habitat loss for a certain Species based on ESA CCI Landcover data. It uses Point observations which are fetched from GBIF",
    "author": [
      {
        "name": "Simon Pahls",
        "email": "simon.pahls@uzh.ch",
        "identifier": null
      }
    ],
    "license": null,
    "external_link": null,
    "references": [
