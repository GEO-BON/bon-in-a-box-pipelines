  "inputs": {
    "pipeline@210": {
      "label": "Species",
      "description": "species of interest, will be used to look for GBIF observations.",
      "type": "text",
      "example": "Panthera onca",
      "weight": 0
    },
    "pipeline@208": {
      "label": "End year",
      "description": "end year of interest",
      "type": "float[]",
      "example": [
        2015
      ],
      "weight": 1
    },
    "pipeline@214": {
      "label": "Size of buffer",
      "description": "Radius size [in km] to determine population presence around the coordinates of species observations.",
      "type": "float",
      "example": 10,
      "weight": 2
    },
    "pipeline@215": {
      "label": "Distance between populations",
      "description": "Distance [in km] to separate species observations in different populations.",
      "type": "float",
      "example": 50,
      "weight": 3
    },
    "pipeline@209": {
      "label": "Start year",
      "description": "start year of interest",
      "type": "float[]",
      "example": [
        2010
      ],
      "weight": 4
    },
    "pipeline@211": {
      "label": "Countries list",
      "description": "countries of interest, will be used to look for GBIF observations.",
      "type": "text[]",
      "example": [
        "Colombia"
      ],
      "weight": 5
    },
    "pipeline@212": {
      "label": "Bounding box",
      "description": "bounding box around area of interest",
      "type": "float[]",
      "example": [],
      "weight": 6
    },
    "pipeline@224": {
      "label": "Ne:Nc ratio estimate",
      "description": "Estimated Ne:Nc ratio for the studied species. Multiple values can be provided, separated by a comma.",
      "type": "float[]",
      "example": [
        0.1,
        0.2
      ],
      "weight": 7
    },
    "pipeline@225": {
      "label": "Population density",
      "description": "Estimated density of the population [number of individuals per km2]. Multiple values can be provided, separated by a comma.",
      "type": "float[]",
      "example": [
        50,
        100,
        1000
      ],
      "weight": 8
    },
    "pipeline@226": {
      "label": "Title of the run",
      "description": "Set a name for the pipeline run.",
      "type": "text",
      "example": "Quercus sartorii, Mexico, Habitat decline by tree cover loss, 2000-2023",
      "weight": 9
    }
  },
  "outputs": {
    "GFS_IndicatorsTool>get_Indicators.yml@223|ne_table": {
      "description": "Estimated effective size of every population, based on the latest time point of the habitat cover map.",
      "label": "Effective population size",
      "type": "text/tab-separated-values",
      "weight": 0
    },
    "GFS_IndicatorsTool>get_Indicators.yml@223|pm": {
      "description": "Estimated proportion of mantained populations, comparing earliest and latest time point. A value of 1 means that no populations went extinct over the time frame.",
      "label": "Population maintained indicator",
      "type": "float",
      "weight": 1
    },
    "GFS_IndicatorsTool>get_Indicators.yml@223|interactive_plot": {
      "description": "An interactive interface to explore indicators trends across geographical space and time.",
      "label": "Interactive plot",
      "type": "text/html",
      "weight": 2
    },
    "GFS_IndicatorsTool>get_Indicators.yml@223|ne500": {
      "description": "Estimated proportion of populations with Ne>500 at latest time point.",
      "label": "Ne>500 indicator",
      "type": "float",
      "weight": 3
    },
    "GenesFromSpace>ToolComponents>Interface>TC_area.json@231|GFS_IndicatorsTool>get_TCY.yml@203|tcyy": {
      "description": "Path to folder with tif files summarizing year-by-year treecover of every population.",
      "label": "Tree cover year-by-year",
      "type": "text",
      "weight": 4
    }
  }
